# yaml-language-server: $schema=https://huacnlee.github.io/autocorrect/schema.json
# Default rules: https://github.com/huacnlee/autocorrect/raw/main/autocorrect/.autocorrectrc.default
rules:
  space-word: 1
  space-punctuation: 1
  space-bracket: 1
  space-backticks: 1
  space-dash: 0
  space-dollar: 1
  fullwidth: 1
  no-space-fullwidth: 1
  no-space-fullwidth-quote: 1
  halfwidth-word: 1
  halfwidth-punctuation: 1
  spellcheck: 1
context:
  codeblock: 2
textRules:
fileTypes:
  md: markdown
spellcheck:
  words:
